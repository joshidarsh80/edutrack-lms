generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  TEXT
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  GRADED
}

enum RevisionStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum NotificationType {
  ENROLLMENT
  DEADLINE
  ASSIGNMENT_SUBMISSION
  GRADE
  QUIZ
  ANNOUNCEMENT
  ACHIEVEMENT
  REVISION
  PEER_REVIEW
  ROOM
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(STUDENT)
  emailVerified           DateTime?
  image                   String?
  suspendedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  studentProfile          StudentProfile?
  instructorProfile       InstructorProfile?
  courses                 Course[]                 @relation("CourseInstructor")
  enrollments             Enrollment[]
  lessonProgress          LessonProgress[]
  submissions             AssignmentSubmission[]
  quizAttempts            QuizAttempt[]
  reviews                 CourseReview[]
  notifications           Notification[]
  sessions                Session[]
  accounts                Account[]
  certificates            Certificate[]
  achievements            StudentAchievement[]
  studySessions           StudySession[]
  revisions               RevisionSession[]
  portfolio               Portfolio?
  focusRooms              FocusRoom[]              @relation("RoomHost")
  roomParticipations      FocusRoomParticipant[]
  roomMessages            FocusRoomMessage[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  challengeParticipations ChallengeParticipation[]
  passwordResetTokens     PasswordResetToken[]
  learningGoals           LearningGoal[]
  peerReviews             PeerReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StudentProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  bio               String?
  timezone          String  @default("Asia/Kolkata")
  weeklyGoalMinutes Int     @default(300)
  publicPortfolio   Boolean @default(false)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  headline String?
  website  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
}

model Course {
  id            String               @id @default(cuid())
  instructorId  String
  categoryId    String
  title         String
  slug          String               @unique
  subtitle      String
  description   String               @db.Text
  language      String               @default("English")
  difficulty    Difficulty           @default(BEGINNER)
  price         Int                  @default(0)
  thumbnailUrl  String?
  promoVideoUrl String?
  status        CourseStatus         @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  instructor    User                 @relation("CourseInstructor", fields: [instructorId], references: [id])
  category      CourseCategory       @relation(fields: [categoryId], references: [id])
  sections      CourseSection[]
  enrollments   Enrollment[]
  reviews       CourseReview[]
  prerequisites CoursePrerequisite[] @relation("DependentCourse")
  requiredFor   CoursePrerequisite[] @relation("RequiredCourse")
  assignments   Assignment[]
  quizzes       Quiz[]
  announcements CourseAnnouncement[]
  changeLog     CourseChangeLog[]
  certificates  Certificate[]

  @@index([status, categoryId, difficulty])
  @@index([instructorId])
}

model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id              String           @id @default(cuid())
  sectionId       String
  title           String
  description     String?
  type            LessonType       @default(VIDEO)
  videoUrl        String?
  textContent     String?          @db.Text
  durationSeconds Int              @default(0)
  isPreview       Boolean          @default(false)
  position        Int
  section         CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources       LessonResource[]
  progress        LessonProgress[]

  @@unique([sectionId, position])
  @@index([sectionId])
}

model LessonResource {
  id       String  @id @default(cuid())
  lessonId String
  title    String
  url      String
  mimeType String?
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, enrolledAt])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  completedAt         DateTime?
  lastPositionSeconds Int       @default(0)
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

model CoursePrerequisite {
  id                   String @id @default(cuid())
  courseId             String
  prerequisiteCourseId String
  course               Course @relation("DependentCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite         Course @relation("RequiredCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  body      String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

model Assignment {
  id           String                 @id @default(cuid())
  courseId     String
  title        String
  instructions String                 @db.Text
  dueAt        DateTime?
  maxPoints    Int                    @default(100)
  createdAt    DateTime               @default(now())
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  text         String?          @db.Text
  fileUrl      String?
  status       SubmissionStatus @default(IN_PROGRESS)
  score        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime?
  late         Boolean          @default(false)
  gradedAt     DateTime?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerReviews  PeerReview[]

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
}

model Quiz {
  id               String         @id @default(cuid())
  courseId         String
  title            String
  timeLimitMinutes Int?
  maxAttempts      Int            @default(1)
  passingScore     Int            @default(70)
  published        Boolean        @default(false)
  resultsReleaseAt DateTime?
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]
}

model QuizQuestion {
  id       String       @id @default(cuid())
  quizId   String
  prompt   String       @db.Text
  type     String
  points   Int          @default(1)
  position Int
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  QuizOption[]
  answers  QuizAnswer[]

  @@unique([quizId, position])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  position   Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  quizId      String
  userId      String
  startedAt   DateTime     @default(now())
  submittedAt DateTime?
  score       Int?
  status      String       @default("IN_PROGRESS")
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([quizId, userId, submittedAt])
}

model QuizAnswer {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  optionIds     String[]
  textAnswer    String?
  pointsAwarded Int          @default(0)
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  code     String   @unique
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Achievement {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String
  icon        String?
  points      Int                  @default(0)
  awards      StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model LearningGoal {
  id            String   @id @default(cuid())
  userId        String
  weekStart     DateTime
  targetMinutes Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model StudySession {
  id              String    @id @default(cuid())
  userId          String
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  courseId        String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model RevisionSession {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  dueAt       DateTime
  status      RevisionStatus @default(SCHEDULED)
  completedAt DateTime?
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt, status])
}

model Portfolio {
  id               String             @id @default(cuid())
  userId           String             @unique
  slug             String             @unique
  isPublic         Boolean            @default(false)
  showCertificates Boolean            @default(true)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects         PortfolioProject[]
}

model PortfolioProject {
  id          String    @id @default(cuid())
  portfolioId String
  title       String
  description String    @db.Text
  skills      String[]
  imageUrl    String?
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model PeerReview {
  id           String               @id @default(cuid())
  submissionId String
  reviewerId   String
  accuracy     Int?
  presentation Int?
  completeness Int?
  creativity   Int?
  technical    Int?
  feedback     String?              @db.Text
  anonymous    Boolean              @default(true)
  moderatedAt  DateTime?
  createdAt    DateTime             @default(now())
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User                 @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerId])
  @@index([reviewerId])
}

model FocusRoom {
  id           String                 @id @default(cuid())
  hostId       String
  title        String
  goal         String?
  isPrivate    Boolean                @default(false)
  inviteCode   String?                @unique
  focusMinutes Int                    @default(25)
  breakMinutes Int                    @default(5)
  createdAt    DateTime               @default(now())
  host         User                   @relation("RoomHost", fields: [hostId], references: [id])
  participants FocusRoomParticipant[]
  messages     FocusRoomMessage[]
}

model FocusRoomParticipant {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  room     FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model FocusRoomMessage {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  room      FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model CourseAnnouncement {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseChangeLog {
  id        String   @id @default(cuid())
  courseId  String
  actorId   String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model Challenge {
  id           String                   @id @default(cuid())
  title        String
  description  String
  goalType     String
  goalValue    Int
  startsAt     DateTime
  endsAt       DateTime
  participants ChallengeParticipation[]
}

model ChallengeParticipation {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  progress    Int       @default(0)
  completedAt DateTime?
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  userId      String
  period      String
  periodStart DateTime
  points      Int      @default(0)
  isPrivate   Boolean  @default(false)

  @@unique([userId, period, periodStart])
  @@index([period, periodStart, points])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
}
