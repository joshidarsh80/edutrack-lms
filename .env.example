# PostgreSQL connection string for local development or Neon/Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edutrack?schema=public"

# Set to a long random secret before deployment
NEXTAUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
DEMO_PASSWORD="replace-with-a-demo-password"

# Optional S3-compatible storage configuration
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="edutrack"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
